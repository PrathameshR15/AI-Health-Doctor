# Smart Health AI Configuration
ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./smart_health_ai.db

# Option 1: Direct OpenAI API Credentials (e.g. gpt-4o, gpt-4o-mini)
# Best model for disease predicting from symptoms: gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Option 2: OpenRouter API Credentials
# Recommended models: openai/gpt-4o-mini, openai/gpt-4o, meta-llama/llama-3.3-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
